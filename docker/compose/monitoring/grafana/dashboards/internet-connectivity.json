{
  "uid": "homelab-internet-connectivity",
  "title": "Internet Connectivity",
  "tags": [
    "homelab",
    "network"
  ],
  "description": "インターネット回線の疎通・遅延・パケットロス（ping を 30 秒毎）。遅いと判断する基準は、遅延が 7 日間の中央値の 2 倍かつ 50ms 超。",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "1.1.1.1 への遅延（最新）",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "probe_icmp_duration_seconds{phase=\"rtt\",service=\"internet-cloudflare\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "遅延の 7 日間の中央値（通知の基準）",
      "description": "この 2 倍かつ 50ms 超が 10 分続くと InternetLatencyHigh が発報する。",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "quantile_over_time(0.5, probe_icmp_duration_seconds{phase=\"rtt\",service=\"internet-cloudflare\"}[7d])",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "パケットロス（直近 10 分）",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "1 - avg_over_time(probe_success{service=\"internet-cloudflare\"}[10m])",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "疎通（ルーター / 1.1.1.1 / 8.8.8.8）",
      "description": "1 = 3 か所とも届いている。0 を含むと、どこかに届いていない。",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "min(probe_success{service=~\"gateway|internet-.*\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "ping の遅延（RTT）",
      "description": "ルーター → 建物の共用ルーター → インターネットの順に遅延が増える。建物の共用ルーターまでで高ければ建物内、そこまで低くてその先で高ければ ISP 側。",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "probe_icmp_duration_seconds{phase=\"rtt\",service=\"gateway\"}",
          "legendFormat": "ルーター",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "probe_icmp_duration_seconds{phase=\"rtt\",service=\"building-router\"}",
          "legendFormat": "建物の共用ルーター",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "probe_icmp_duration_seconds{phase=\"rtt\",service=\"internet-cloudflare\"}",
          "legendFormat": "1.1.1.1",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "probe_icmp_duration_seconds{phase=\"rtt\",service=\"internet-google\"}",
          "legendFormat": "8.8.8.8",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "2 * quantile_over_time(0.5, probe_icmp_duration_seconds{phase=\"rtt\",service=\"internet-cloudflare\"}[7d])",
          "legendFormat": "1.1.1.1 の通知しきい値（中央値の 2 倍。50ms 未満なら通知しない）",
          "refId": "E"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "疎通（5 分間の成功率）",
      "description": "1 未満はパケットロス。0 が続くと回線断（InternetDown）。",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "auto"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "avg_over_time(probe_success{service=\"gateway\"}[5m])",
          "legendFormat": "ルーター",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "avg_over_time(probe_success{service=\"building-router\"}[5m])",
          "legendFormat": "建物の共用ルーター",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "avg_over_time(probe_success{service=\"internet-cloudflare\"}[5m])",
          "legendFormat": "1.1.1.1",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "avg_over_time(probe_success{service=\"internet-google\"}[5m])",
          "legendFormat": "8.8.8.8",
          "refId": "D"
        }
      ]
    }
  ]
}
